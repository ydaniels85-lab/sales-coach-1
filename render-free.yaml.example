# Temporary test Blueprint only.
# This build has no login protection. Do not use real client reports on a public test URL.
services:
  - type: web
    name: fin-tastic-render-test
    runtime: docker
    plan: free
    region: frankfurt
    dockerfilePath: ./Dockerfile
    dockerContext: .
    healthCheckPath: /api/health
    autoDeployTrigger: commit
    envVars:
      - key: DATABASE_URL
        fromDatabase:
          name: fin-tastic-postgres-test
          property: connectionString
      - key: OWNER_EMAIL
        value: ydaniels85@gmail.com
      - key: DEFAULT_TENANT_ID
        value: khusela-debt-management
      - key: DEFAULT_TENANT_NAME
        value: Khusela Debt Management
      - key: DEFAULT_CREDIT_REPORT_PDF_PASSWORD
        sync: false
      - key: OPEN_ACCESS_OPERATOR_ID
        value: open-access
      - key: WEB_CONCURRENCY
        value: "1"
      - key: GUNICORN_THREADS
        value: "4"
      - key: GUNICORN_TIMEOUT
        value: "180"

databases:
  - name: fin-tastic-postgres-test
    databaseName: fintastic_test
    user: fintastic_test_app
    plan: free
    region: frankfurt
    ipAllowList: []
